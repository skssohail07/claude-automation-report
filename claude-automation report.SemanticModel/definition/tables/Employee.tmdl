	partition Employee = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "employees.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"EmpID", Int64.Type}, {"Name", type text}, {"Gender", type text}, {"DeptID", Int64.Type}, {"HireDate", type date}, {"LeaveDate", type date}, {"Salary", Int64.Type}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
