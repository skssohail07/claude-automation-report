	partition Department = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "departments.csv"), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"DeptID", Int64.Type}, {"DeptName", type text}, {"Budget", Int64.Type}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
