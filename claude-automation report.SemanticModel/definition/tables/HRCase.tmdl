	partition HRCase = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "hr_cases.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"CaseID", Int64.Type}, {"DeptID", Int64.Type}, {"CaseType", type text}, {"OpenDate", type date}, {"DaysToClose", Int64.Type}, {"OnTime", Int64.Type}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
