{
  "name": "claude-automation theme",
  "dataColors": [
    "#1F3A5F",
    "#2A9D8F",
    "#E76F51",
    "#6C757D",
    "#4A6C93",
    "#7CC6BC",
    "#F0A58F",
    "#A3AAB0"
  ],
  "foreground": "#1F3A5F",
  "foregroundNeutralSecondary": "#6C757D",
  "foregroundNeutralTertiary": "#A3AAB0",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F7FA",
  "backgroundNeutral": "#E3E8EF",
  "tableAccent": "#1F3A5F",
  "good": "#2E7D32",
  "neutral": "#E76F51",
  "bad": "#C0392B",
  "maximum": "#1F3A5F",
  "center": "#2A9D8F",
  "minimum": "#F5F7FA",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#1F3A5F"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F3A5F"
    },
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 28,
      "color": "#1F3A5F"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#495057"
    },
    "largeTitle": {
      "fontFace": "Segoe UI",
      "fontSize": 20,
      "color": "#1F3A5F"
    },
    "smallLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#6C757D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E3E8EF" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 14,
            "bold": true,
            "fontColor": { "solid": { "color": "#1F3A5F" } }
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F5F7FA" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F5F7FA" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 28,
            "color": { "solid": { "color": "#1F3A5F" } }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": { "solid": { "color": "#6C757D" } }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontFamily": "Segoe UI",
            "fontColor": { "solid": { "color": "#6C757D" } },
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontColor": { "solid": { "color": "#1F3A5F" } },
            "backColor": { "solid": { "color": "#F5F7FA" } }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontColorPrimary": { "solid": { "color": "#212529" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#212529" } },
            "backColorSecondary": { "solid": { "color": "#F8F9FB" } }
          }
        ]
      }
    }
  }
}
